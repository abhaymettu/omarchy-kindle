{
  "version": 1,
  "idle": {
    "screensaver": 86400,
    "lock": 86400
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        { "id": "omarchy.workspaces" }
      ],
      "center": [
        { "id": "omarchy.clock", "format": "dddd HH:mm", "formatAlt": "d MMMM 'W'ww yyyy", "verticalFormat": "HH\n—\nmm" }
      ],
      "right": [
        { "id": "omarchy.network" },
        { "id": "omarchy.power" }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": ["foot", "firefox"]
  },
  "plugins": []
}
